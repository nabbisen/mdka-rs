# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.swp
.DS_Store

*.log

# napi
node_modules/
*.node
bun.lock
bun.lockb
# generated: napi create-npm-dirs writes per-platform package dirs here at publish time
node/npm/
.env
.env.*
!.env.example

python/.venv/
**/__pycache__/
*.pyc
*.pyo
# generated: release-pypi.yaml copies the root README here at build time
python/README.md
python/mdka/*.so

# mdBook build output
docs/book/

# Internal governance and correspondence: release records, review requests,
# reviews, handover packages, upstream letters, scratch. Never published.
# This lives here rather than in .git/info/exclude, which is per-clone and not
# shared: a fresh clone would not ignore it, and the first `git add -A` could
# commit third-party correspondence. The rule has to travel with the repository.
/.git-exclude/
